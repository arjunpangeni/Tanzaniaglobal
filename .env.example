# MongoDB — required for contact, appointments, and admin CMS
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/tanzania-global

# Auth.js / Google (admin only)
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated allow-list
ADMIN_EMAILS=you@gmail.com

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP=255700000000
NEXT_PUBLIC_HERO_VIDEO_URL=

# Google reCAPTCHA v2 (https://www.google.com/recaptcha/admin)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Cloudinary (admin uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
